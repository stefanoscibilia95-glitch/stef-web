
@unpublished{scibilia_external_2026,
	location = {Rotterdam},
	title = {From External to Internal Constraints? Nominal Compliance and the Europeanization of Socio-Economic Reforms Under the Recovery and Resilience Facility in Spain},
	shorttitle = {From External to Internal Constraints?},
	abstract = {How do external and internal constraints shape the Europeanization of national socio-economic reform? The dominant view holds that supranational {EU} constraints —of which the Recovery and Resilience Facility ({RRF}) is the latest major iteration— empower governments to overcome domestic opposition by tying their hands to {EU} commitments. We invert this logic: governments with weak parliamentary support may deploy social pacts as an internal constraint to gain autonomy vis-à-vis the Commission. We test these rival mechanisms through a congruence analysis of Spanish pension and labour market reforms (2018–2024). The internal constraint explanation prevails. Spain’s pre-existing social dialogue agenda shaped the reform commitments in its national recovery plan and allowed the government to use social pacts as leverage to secure the Commission’s approval of reforms that were only nominally {EUcompliant}, while diverging in policy substance. As the {RRF}-inspired principle of national ownership is being extended across other {EU} economic and budgetary instruments, the Spanish case shows how it can also work against the Commission’s own socio-economic agenda.},
	pagetotal = {40},
	publisher = {Erasmus University Rotterdam},
	type = {Manuscript under review},
	howpublished = {Manuscript under review},
	author = {Scibilia, Stefano and Haverland, Markus},
	date = {2026-07-30},
	langid = {english},
	file = {PDF:/Users/stef/Zotero/storage/7GMKAAFX/Scibilia and Haverland - 2026 - From External to Internal Constraints Nominal Compliance and the Europeanization of Socio-Economic.pdf:application/pdf},
}

@inproceedings{scibilia_recovery_2026,
	location = {Catania},
	title = {From the Recovery and Resilience plans to the Medium-term Fiscal-structural plans: the  case of pension policy},
	url = {https://ecpr.eu/Events/Event/PaperDetails/86258},
	abstract = {The 2024 reform of the Stability and Growth Pact grants Member States the possibility of extending their fiscal-adjustment path from four to seven years in exchange for a "relevant set of reforms and investments" commitments, to be included in the newly devised National Medium-Term Fiscal-Structural Plans ({MTFSPs}). We argue that this makes the {MTFSPs} similar and thus comparable to the National Recovery and Resilience Plans ({NRRPs}), apart from one significant difference. While the {NRRPs} were the product of an unprecedented external crisis which sparked an equally unprecedented {EU} fiscal solidarity, the {MTFSPs} were readied in what we call an adversarial environment, marked by the return of binding fiscal rules and surging defence and security spending. In this paper, we ask how this shift has affected pension reform commitments. Two different views emerge. One strand of the literature holds that the {EU} governance architecture remains predominantly oriented towards commodification. As such, a shift towards an adversarial environment further compounds this preexisting stance, so that pension commitments tilt toward benefit cost-containment, longer working lives, and supplementary pensions. A second strand of the literature holds instead that, despite the notable absence of the {NRRP}’s fiscal transfers, the new {MTFSPs} could have decommodifying pension commitments, such as increased social contribution, on the back of increasingly “socialized” {EU} socio-economic governance instruments. We examine these expectations against the pension commitments of all eight Member States on the seven-year track (Austria, Belgium, Germany, Finland, France, Italy, Romania, Spain). We coded the reforms along a novel five-part typology, in a systematic comparison of pension commitments across {NRRP} and {MTFSPs}. We find that commodifying reforms are more numerous in relation to the {MTFSPs} commitments, and above all reform extending working lives, while the isolated cases of decommodification-oriented commitments of the {NRRP}, largely driven by Spain alone, are mostly absent in the {MTFSPs}. When including reforms enacted outside the plans, a detectable decommodifying countercurrent emerges, which partly counterbalances any clean commodification reading of pension reform trajectories. Overall, the evidence leans towards the commodification expectation: an already market-making {EU} governance, compounded by the adversarial environment, widens the reach of commodifying pension reforms, while decommodification finds only limited support and travels mainly through domestic channels.},
	eventtitle = {13th Biennial Conference of the {ECPR} Standing Group on the European Union},
	booktitle = {{EU} Socio-Economic Governance after the Pandemic},
	author = {Scibilia, Stefano},
	date = {2026-07-01},
	langid = {american},
	file = {PDF:/Users/stef/Zotero/storage/AS7T3RVV/Scibilia - 2026 - From the Recovery and Resilience plans to the Medium-term Fiscal-structural plans the  case of pens.pdf:application/pdf},
}

@inproceedings{scibilia_domestic_2025,
	location = {Philadelphia},
	title = {Domestic Coalitions and Compliance in the European Semester: Does the Recovery and Resilience Facility Make a Difference in Italy?},
	url = {https://www.eustudies.org/conference/papers/download/1154},
	abstract = {The Recovery and Resilience Facility ({RRF}) links the disbursement of funds to compliance with Country-Specific Recommendations ({CSRs}) drafted by the {EU} Commission and approved by the Council as part of the European Semester ({ES}). Research so far has concentrated on the governance innovations of the {RRF}, on the role of domestic executives, and on other factors such as the levels of ownership, centralization and socialization of National Recovery and Resilience Plans ({NRRPs}). We shift the focus towards the domestic politics of political parties and interest groups constituting an interest constellation over a given reform area, combining insights from the Europeanization literature (Knill and Lehmkuhl, 1999, 2002) with current political economy perspectives on welfare reform formation. We argue that, if an interest constellation is dominated by a coalition of domestic policy stakeholders, it will neutralize the effect of the {RRF} on reforms and likely cause noncompliance. If the interest constellation is instead contested between rival coalitions of policy stakeholders, the {RRF} will be decisive in tilting the balance towards {CSRcompliant} reform.  We test our theoretically informed propositions on the crucial Italian case. Using causal process tracing, we rely on archival research and interviews to reconstruct pension policies and active labour market policies ({ALMPs}) trajectories in the 2011-2023 {ES} timeframe, hence including the pre-{RRF} phase of the {ES}, to better isolate the effect of the {RRF}. For the case of pensions, we have traced the existence of a dominated interest constellation composed of an entrenched and bipartisan coalition of political parties and social partners, advocating for pension expansion. Despite {CSRs} asking for pension retrenchment, this coalition successfully obtained a series of increasingly expansive pension schemes, in direct noncompliance with the  1 Corresponding author. E-mail scibilia@essb.eur.nl. {ES}. The introduction of the {RRF} was not sufficient in altering the dominance of this expansionary coalition, that managed to remove any commitments to budget-saving pension reforms from the Italian {NRRP}, hence neutralising its potential effect, and further continuing on a non-compliant reform trajectory. Our analysis of {ALMPs} highlights the presence of a contested interest constellation, with two similarly influential rival coalitions, one supporting stricter benefit conditionality policies and a liberalized {ALMPs} regime, and the other supported human capital acquisition policies and a public-first {ALMPs} regime. In this context, the pre-{RRF} {ES} compliance was low. The {CSRs} were sufficient to cause {EU} compliant domestic reforms towards stricter benefit conditionality and public-first {ALMPs} governance, but domestic change remained mostly on paper, as each rival coalition successfully opposed implementation. After the {RRF} was introduced, the additional resources and strict timeline for {NRRP}, combined with the Commission’s shift towards a more skill oriented {ALMPs} regime, were instrumental in tilting the balance towards an {ALMPs} package favouring human capital acquisition and public-first {ALMPs} governance.  Our findings cast doubts on the potential effectiveness of linking expenditure with reforms. The possible {RRF}-ization of future {EU} programmes, such as the Multiannual Financial Framework 2028-2034, might not lead to the delivery of structural reforms for which Member States have preexisting dominated interest constellations upholding a policy platform incompatible with the {CSRs}.},
	eventtitle = {European Union Studies Association 19th Biennial Conference},
	booktitle = {The Changing Dynamics of Economic Governance in the European Union},
	author = {Scibilia, Stefano and Haverland, Markus and Tuytens, Pieter and Zhelyazkova, Asya},
	date = {2025-05-08},
	langid = {american},
	file = {PDF:/Users/stef/Zotero/storage/XXSG6SQV/Scibilia et al. - 2025 - Domestic Coalitions and Compliance in the European Semester Does the Recovery and Resilience Facili.pdf:application/pdf},
}

@inproceedings{scibilia_tilting_2024,
	location = {Lisbon},
	title = {Tilting the Balance: The Recovery and Resilience Facility and Labor Market Reforms Inside the Italian Political Laboratory},
	url = {https://ecpr.eu/Events/Event/PaperDetails/73293},
	abstract = {In this paper, we research the effect of the Recovery and Resilience Facility ({RRF}), on compliance with Country Specific Recommendations ({CSRs}) contained within the European Semester. We propose that the combination of two different dynamics can explain economic reform outcomes of National Recovery and Resilience Plans ({NRRPs}). At the {EU} level, we argue that the Commission holds an institutional self-interest towards a successful {RRF}, leading towards a relatively more political rather than technocratic governance approach. At a Member State level, interest group politics and partisan politics is characterized by the existence of powerful vested interests which ultimately determine policy change or persistence. We test our claim within the Italian {NRRP}, using documental and interview data. Our (preliminary) findings seem to indicate that the Commission relatively political attitude, combined with powerful Italian vested interests ultimately produced “minimum common denominator” welfare reforms in active labour market policies and anti-undeclared work policies, while avoiding a costly pension reform.},
	eventtitle = {12th Biennial Conference of the {ECPR} Standing Group on the European Union},
	booktitle = {Next Generation {EU} and the Recovery and Resilience Facility: a new governance model for the {EU} distributive policies},
	author = {Scibilia, Stefano and Haverland, Markus and Tuytens, Pieter and Zhelyazkova, Asya},
	date = {2024-06-19},
	file = {PDF:/Users/stef/Zotero/storage/WR78IM6K/Scibilia et al. - 2024 - Tilting the Balance The Recovery and Resilience Facility and Labor Market Reforms Inside the Italia.pdf:application/pdf},
}
